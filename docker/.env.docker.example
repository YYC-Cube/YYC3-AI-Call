# ===================================================================
# Docker Compose 环境变量 - docker/.env.docker.example
# ===================================================================
#
# 说明：
# 1. 复制本文件为 docker/.env.docker
# 2. 用于 docker-compose.yml 中的容器配置
# 3. 定义数据库、缓存等服务的环境变量
#
# ===================================================================

# ===================================================================
# PostgreSQL 容器配置
# ===================================================================

# PostgreSQL 镜像版本
POSTGRES_VERSION=16-alpine

# PostgreSQL 超级用户
POSTGRES_USER=postgres

# PostgreSQL 超级用户密码（必须修改，使用强密码）
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

# PostgreSQL 数据库名称
POSTGRES_DB=yyc3_db

# PostgreSQL 绑定地址（0.0.0.0 允许外部连接）
POSTGRES_HOST_BIND_ADDRESS=0.0.0.0

# PostgreSQL 端口
POSTGRES_PORT=5432

# PostgreSQL 数据卷挂载点
POSTGRES_DATA_DIR=/var/lib/postgresql/data

# PostgreSQL 连接超时（秒）
POSTGRES_CONNECT_TIMEOUT=10

# 创建专门的数据库用户（而不是使用 postgres）
POSTGRES_APP_USER=yyc3_user
POSTGRES_APP_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD

# ===================================================================
# Redis 容器配置
# ===================================================================

# Redis 镜像版本
REDIS_VERSION=7-alpine

# Redis 端口
REDIS_PORT=6379

# Redis 绑定地址
REDIS_BIND_ADDRESS=0.0.0.0

# Redis 密码（必须修改，使用强密码）
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# Redis 数据卷挂载点
REDIS_DATA_DIR=/var/lib/redis/data

# Redis 最大内存（字节）
REDIS_MAX_MEMORY=512mb

# Redis 内存淘汰策略
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Redis 持久化（RDB 快照间隔）
REDIS_SAVE_INTERVAL=300

# ===================================================================
# Nginx 容器配置
# ===================================================================

# Nginx 镜像版本
NGINX_VERSION=1.27-alpine

# Nginx 端口（HTTP）
NGINX_HTTP_PORT=80

# Nginx 端口（HTTPS）
NGINX_HTTPS_PORT=443

# Nginx 工作进程数
NGINX_WORKER_PROCESSES=auto

# Nginx 连接数
NGINX_WORKER_CONNECTIONS=1024

# Nginx SSL 证书路径（容器内路径）
NGINX_SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
NGINX_SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ===================================================================
# 应用容器配置
# ===================================================================

# 应用名称
APP_NAME=yyc3-ai-call

# 应用镜像标签
APP_IMAGE_TAG=latest

# 应用端口
APP_PORT=3000

# 应用容器名称
APP_CONTAINER_NAME=yyc3-app

# 应用副本数（如使用 Docker Stack）
APP_REPLICAS=1

# 应用资源限制
APP_MEMORY_LIMIT=2g
APP_MEMORY_RESERVATION=1g
APP_CPU_LIMIT=1.0
APP_CPU_RESERVATION=0.5

# ===================================================================
# 网络配置
# ===================================================================

# Docker 网络名称
DOCKER_NETWORK_NAME=yyc3-network

# 网络模式
DOCKER_NETWORK_MODE=bridge

# ===================================================================
# 卷配置
# ===================================================================

# PostgreSQL 数据卷名称
POSTGRES_VOLUME_NAME=yyc3-postgres-data

# Redis 数据卷名称
REDIS_VOLUME_NAME=yyc3-redis-data

# 应用上传文件卷名称
APP_UPLOADS_VOLUME_NAME=yyc3-uploads

# Nginx 日志卷名称
NGINX_LOGS_VOLUME_NAME=yyc3-nginx-logs

# ===================================================================
# 日志配置
# ===================================================================

# 日志驱动（json-file | syslog | awslogs）
LOG_DRIVER=json-file

# 日志文件最大大小
LOG_MAX_SIZE=10m

# 日志文件最大数量
LOG_MAX_FILE=3

# ===================================================================
# 时区配置
# ===================================================================

# 容器时区
TIMEZONE=Asia/Shanghai

# ===================================================================
# 健康检查配置
# ===================================================================

# 健康检查间隔（秒）
HEALTH_CHECK_INTERVAL=30

# 健康检查超时（秒）
HEALTH_CHECK_TIMEOUT=10

# 健康检查重试次数
HEALTH_CHECK_RETRIES=3

# 健康检查启动延迟（秒）
HEALTH_CHECK_START_PERIOD=40

# ===================================================================
# 开发环境特定配置
# ===================================================================

# 是否挂载源代码（开发环境 true，生产环境 false）
MOUNT_SOURCE_CODE=true

# 是否启用调试模式
DEBUG_MODE=false

# ===================================================================
# 生产环境特定配置
# ===================================================================

# 重启策略（no | always | unless-stopped | on-failure）
RESTART_POLICY=unless-stopped

# 日志保留时间
LOG_RETENTION_DAYS=7

# ===================================================================
# 使用示例
# ===================================================================
#
# 步骤 1：复制文件
#   cp docker/.env.docker.example docker/.env.docker
#
# 步骤 2：编辑配置
#   vim docker/.env.docker
#
# 步骤 3：加载环境变量启动
#   docker-compose --env-file docker/.env.docker up -d
#
# 步骤 4：验证服务
#   docker-compose ps
#   docker-compose logs -f
#
# ===================================================================
