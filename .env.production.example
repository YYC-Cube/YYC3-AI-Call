# ===================================================================
# YYC³ AI Intelligent Calling - 生产环境变量
# ===================================================================
#
# 说明：
# 1. 本文件作为生产环境的配置模板
# 2. 所有值都需要替换为实际的生产配置
# 3. 敏感信息应通过密钥管理服务管理（如 AWS Secrets Manager）
# 4. 严禁在源代码中硬编码敏感信息
# 5. 所有密钥必须使用强密码生成
#
# ===================================================================

# ===================================================================
# 1. 应用基础配置
# ===================================================================

NODE_ENV=production
NEXT_PUBLIC_APP_NAME=YYC³ AI Intelligent Calling Center
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NEXT_PUBLIC_API_URL=https://your-production-domain.com/api

DEBUG=false

# ===================================================================
# 2. 数据库配置（生产 PostgreSQL）
# ===================================================================

# 生产数据库连接字符串（必须使用强密码和 SSL 连接）
DATABASE_URL=postgresql://prod_user:REPLACE_WITH_STRONG_PASSWORD@prod-db.example.com:5432/yyc3_production?sslmode=require

# 数据库连接池大小（生产推荐 20-50）
DATABASE_POOL_SIZE=30

# 数据库连接超时
DATABASE_CONNECTION_TIMEOUT=30

# ===================================================================
# 3. Redis 缓存配置（生产 Redis Cluster/Sentinel）
# ===================================================================

# 生产 Redis 连接字符串（必须使用强密码和 SSL）
REDIS_URL=redis://:REPLACE_WITH_STRONG_PASSWORD@prod-redis-1.example.com:6379/0

# Redis 集群配置（如使用集群模式）
REDIS_CLUSTER_ENABLED=false

# Redis DB 选择
REDIS_DB=0

# Redis 连接超时
REDIS_TIMEOUT_MS=10000

# Redis 缓存 TTL
REDIS_CACHE_TTL=86400

# ===================================================================
# 4. 认证与安全配置
# ===================================================================

# JWT 密钥（使用强随机密钥，至少 32 字符）
# 生成：openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_PRODUCTION_JWT_SECRET_MIN_32_CHARS

# JWT 令牌过期时间
JWT_EXPIRES_IN=7d

# NextAuth 基础 URL
NEXTAUTH_URL=https://your-production-domain.com

# NextAuth 密钥（使用强随机密钥，至少 32 字符）
# 生成：openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_PRODUCTION_NEXTAUTH_SECRET_MIN_32_CHARS

# 安全 Cookie 设置
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict
COOKIE_HTTP_ONLY=true

# CORS 允许的来源（多个用逗号分隔）
ALLOWED_ORIGINS=https://your-production-domain.com,https://app.your-production-domain.com

# ===================================================================
# 5. AI 模型配置（生产 Zhipu AI 或 vLLM）
# ===================================================================

# AI 服务基础 URL（生产环境使用 HTTPS 和负载均衡）
AI_BASE_URL=https://api.zhipuai.cn/v1

# AI 模型名称
AI_MODEL=glm-4

# AI 温度参数（生产推荐使用较低的温度以保证稳定性）
AI_TEMPERATURE=0.3

# AI 最大生成令牌数
AI_MAX_TOKENS=2048

# AI 请求超时时间（毫秒）
AI_TIMEOUT_MS=30000

# 其他模型配置（可选）
CODE_MODEL_BASE_URL=https://api.zhipuai.cn/v1
VLM_BASE_URL=https://api.zhipuai.cn/v1

# ===================================================================
# 6. 外部 API 配置
# ===================================================================

# Zhipu AI 官方 API Key（从密钥管理服务获取）
ZHIPU_API_KEY=REPLACE_WITH_PRODUCTION_ZHIPU_API_KEY

# OpenAI API Key（从密钥管理服务获取，可选）
OPENAI_API_KEY=REPLACE_WITH_PRODUCTION_OPENAI_API_KEY

# API 速率限制（生产环境应启用）
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# ===================================================================
# 7. 邮件服务配置（生产环境使用企业邮件）
# ===================================================================

# 使用专业邮件服务商（如 SendGrid、AWS SES 等）
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=REPLACE_WITH_SENDGRID_API_KEY
MAIL_FROM=noreply@your-production-domain.com
MAIL_FROM_NAME=YYC³ Intelligent Calling Center

# 邮件模板路径
MAIL_TEMPLATES_PATH=/app/templates/emails

# ===================================================================
# 8. 短信服务配置
# ===================================================================

SMS_PROVIDER=aliyun
SMS_API_KEY=REPLACE_WITH_ALIYUN_SMS_API_KEY
SMS_API_SECRET=REPLACE_WITH_ALIYUN_SMS_API_SECRET
SMS_SIGNATURE=【YYC³】
SMS_RATE_LIMIT_PER_PHONE_PER_DAY=10

# ===================================================================
# 9. 文件存储配置（生产环境使用对象存储）
# ===================================================================

# 使用 S3 或兼容 S3 的存储（如 Aliyun OSS）
STORAGE_TYPE=s3

# S3 配置
S3_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
S3_REGION=cn-beijing
S3_BUCKET=yyc3-production-files
S3_ACCESS_KEY=REPLACE_WITH_ALIYUN_OSS_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_ALIYUN_OSS_SECRET_KEY
S3_ACL=private

# 文件上传限制
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx,csv,zip

# 文件过期时间（天）
FILE_EXPIRY_DAYS=90

# ===================================================================
# 10. 日志与监控配置
# ===================================================================

# 日志级别
LOG_LEVEL=info

# 日志输出
LOG_OUTPUT=json
LOG_FILE_PATH=/var/log/yyc3-app/app.log
LOG_MAX_FILE_SIZE=104857600
LOG_MAX_BACKUPS=10

# Sentry 错误追踪（生产环境必须配置）
SENTRY_DSN=REPLACE_WITH_PRODUCTION_SENTRY_DSN
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.1

# ELK Stack 日志收集（可选）
ELASTICSEARCH_URL=https://elasticsearch.example.com:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=REPLACE_WITH_ELASTICSEARCH_PASSWORD

# ===================================================================
# 11. 性能与缓存配置
# ===================================================================

# 启用响应缓存
ENABLE_RESPONSE_CACHE=true
CACHE_MAX_AGE=3600

# CDN 配置
CDN_ENABLED=true
CDN_URL=https://cdn.your-production-domain.com

# 启用 Gzip 压缩
ENABLE_GZIP=true
GZIP_LEVEL=6

# ===================================================================
# 12. 速率限制与防护
# ===================================================================

# 启用速率限制
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# 启用 DDoS 防护
ENABLE_DDOS_PROTECTION=true
DDOS_THRESHOLD=1000

# 启用 WAF
ENABLE_WAF=true
WAF_RULES_FILE=/etc/waf/rules.json

# ===================================================================
# 13. 数据库迁移
# ===================================================================

# 生产环境谨慎启用自动迁移
AUTO_RUN_MIGRATIONS=false

# 备份配置
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_SCHEDULE=0 2 * * * # 每天 2:00 AM
DATABASE_BACKUP_RETENTION_DAYS=30

# ===================================================================
# 14. 第三方服务集成
# ===================================================================

# Google Analytics
NEXT_PUBLIC_GA_ID=REPLACE_WITH_PRODUCTION_GA_ID

# Datadog 监控
DATADOG_API_KEY=REPLACE_WITH_DATADOG_API_KEY
DATADOG_APP_KEY=REPLACE_WITH_DATADOG_APP_KEY

# Slack 通知
SLACK_WEBHOOK_URL=REPLACE_WITH_PRODUCTION_SLACK_WEBHOOK
SLACK_CHANNEL=#alerts

# PagerDuty 告警
PAGERDUTY_INTEGRATION_KEY=REPLACE_WITH_PAGERDUTY_KEY

# ===================================================================
# 15. 多租户配置（如启用）
# ===================================================================

ENABLE_MULTI_TENANT=true
TENANT_ISOLATION_TYPE=schema

# ===================================================================
# 16. 功能开关
# ===================================================================

# 生产环境的功能开关
FEATURE_AI_ENABLED=true
FEATURE_CALLING_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true
FEATURE_CUSTOMER_MANAGEMENT_ENABLED=true
FEATURE_MARKETING_AUTOMATION_ENABLED=true
FEATURE_ADVANCED_REPORTS=true
FEATURE_API_WEBHOOKS=true

# Beta 功能（通常在生产中关闭）
FEATURE_BETA_ENABLED=false

# ===================================================================
# 17. Kubernetes 配置（如使用 K8s 部署）
# ===================================================================

# Pod 资源限制
POD_MEMORY_LIMIT=2Gi
POD_CPU_LIMIT=1000m

# 副本数
REPLICAS=3

# 健康检查
HEALTH_CHECK_PATH=/api/health
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_PERIOD=10

# ===================================================================
# 18. 部署信息
# ===================================================================

# 部署区域
DEPLOYMENT_REGION=cn-beijing

# 部署平台（Vercel | Heroku | AWS | Aliyun | Docker）
DEPLOYMENT_PLATFORM=docker

# 构建版本信息
BUILD_VERSION=1.0.0
BUILD_COMMIT_SHA=
BUILD_TIMESTAMP=

# ===================================================================
# 安全检查清单
# ===================================================================
#
# ✅ 必须检查项（部署前）：
#
# [ ] 所有 REPLACE_WITH_* 占位符已替换为实际值
# [ ] JWT_SECRET 和 NEXTAUTH_SECRET 已使用强随机密钥
# [ ] DATABASE_URL 使用 sslmode=require
# [ ] Redis 连接使用强密码
# [ ] 所有 API Key 从密钥管理服务获取
# [ ] CORS ALLOWED_ORIGINS 只包含生产域名
# [ ] LOG_LEVEL 设置为 info（不是 debug）
# [ ] SENTRY_DSN 已配置用于错误监控
# [ ] 邮件服务使用企业提供商（如 SendGrid）
# [ ] 文件存储使用 S3 或 OSS（不是本地存储）
# [ ] 自动迁移 AUTO_RUN_MIGRATIONS 设置为 false
# [ ] CDN 配置正确
# [ ] SSL/TLS 证书已配置
# [ ] 数据库备份已启用
# [ ] 监控告警已配置
# [ ] 日志收集已启用
# [ ] 速率限制已启用
# [ ] DDoS 防护已启用
#
# ===================================================================
# 密钥生成命令
# ===================================================================
#
# JWT Secret:
#   openssl rand -base64 32
#
# NextAuth Secret:
#   openssl rand -base64 32
#
# 强密码（16 字符）:
#   openssl rand -base64 12
#
# ===================================================================
