# =====================================================================
# YYC³ POC 供应商凭证模板
# 用法：cp .env.poc.example .env.poc → 按下方注释填入 → 注入后跑评测
#   set -a; source .env.poc; set +a
#   pnpm tsx scripts/poc-eval.ts --mode asr --vendor volcengine --audio-dir ./poc-assets/asr
#   pnpm tsx scripts/poc-eval.ts --mode asr --vendor iflytek   --audio-dir ./poc-assets/asr
#   pnpm tsx scripts/poc-eval.ts --mode tts
# 安全：.env.poc 已被 .gitignore 排除；禁止提交仓库/写入代码/贴入聊天。
# 开通步骤详情：docs/YYC3-项目闭环-验收系统/YYC3-POC执行手册.md §一
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
# 1) 火山引擎·豆包语音（ASR 主线候选）——录音文件识别极速版
# 开通：https://console.volcengine.com/speech/app
#   「开通管理」勾选「录音文件识别极速版（bigmodel）」→ 创建应用 → 应用详情页取值
# 凭证两代口径（POC执行手册 §一.1 核验点）：
#   旧版控制台：X-Api-App-Key = APP ID，X-Api-Access-Key = Access Token（双 Header）→ 填下面两行
#   新版控制台：仅有 API Key（单 Header X-Api-Key）→ 将 API Key 同时填入下面两行亦可
#   （适配器 asr-volcengine.ts 会以 APP_KEY + ACCESS_KEY 组装 Header）
# ─────────────────────────────────────────────────────────────────────
VOLC_ASR_APP_KEY=            # ← 应用详情页「APP ID」（新版控制台：填 API Key）
VOLC_ASR_ACCESS_KEY=         # ← 同页「Access Token」（新版控制台：填 API Key）
# 资源 ID：默认 volc.bigasr.auc_turbo（极速版）。控制台显示不一致时改
# lib/voice/asr-volcengine.ts 的 X-Api-Resource-Id 常量（手册 §一.1 步骤 1.5）

# ─────────────────────────────────────────────────────────────────────
# 2) 讯飞开放平台（ASR 对照候选）——实时语音转写标准版
# 开通：https://www.xfyun.cn/services/rtasr_standard 领「免费试用 15 天」
#   （1 路授权 / 24 小时时长 / 15 天有效；POC 约 5 分钟音频，额度充裕）
#   → 控制台「我的应用」创建 WebAPI 应用 → 应用的「实时语音转写」服务页取值
# ⚠️ API_KEY 必须是「实时语音转写」服务的 Key——用其他服务（如语音听写）
#    的 Key 会 signa 校验失败 401（POC执行手册 §五 故障排查）
# ─────────────────────────────────────────────────────────────────────
IFLYTEK_APP_ID=              # ← 控制台「我的应用」APPID（8 位左右数字字母）
IFLYTEK_API_KEY=             # ← 实时语音转写服务的 APIKey（32 位左右）

# ─────────────────────────────────────────────────────────────────────
# 3) 阿里云百炼（TTS 主线候选）——CosyVoice v3.5-flash
# 开通：https://bailian.console.aliyun.com/
#   首次进入 → 同意协议 → 「开通服务」（自动发放新人免费额度：仅华北2 北京
#   地域 / 90 天 / 每模型独立；未实名不发放）→ 确认地域为北京
#   → 模型广场开通 cosyvoice-v3.5-flash → API-KEY 管理创建
#   建议开启「用完即停」（免费额度耗尽不自动转付费）
# ─────────────────────────────────────────────────────────────────────
DASHSCOPE_API_KEY=           # ← API-KEY 管理页创建（sk- 开头）

# ─────────────────────────────────────────────────────────────────────
# 核验（填完后逐条确认，任一为空对应供应商评测会明确报错退出）
# ─────────────────────────────────────────────────────────────────────
#   set -a; source .env.poc; set +a
#   echo "火山: ${VOLC_ASR_APP_KEY:+已填}${VOLC_ASR_APP_KEY:-空} / ${VOLC_ASR_ACCESS_KEY:+已填}${VOLC_ASR_ACCESS_KEY:-空}"
#   echo "讯飞: ${IFLYTEK_APP_ID:+已填}${IFLYTEK_APP_ID:-空} / ${IFLYTEK_API_KEY:+已填}${IFLYTEK_API_KEY:-空}"
#   echo "百炼: ${DASHSCOPE_API_KEY:+已填}${DASHSCOPE_API_KEY:-空}"
