# POC 供应商凭证模板 — 复制为 .env.poc 后填充（.env.poc 已被 .gitignore 排除，不入仓库）
# 运行时注入：set -a; source .env.poc; set +a; pnpm tsx scripts/poc-eval.ts --mode asr --vendor volcengine

# ── 火山引擎·豆包语音（ASR 主线候选）──
# 开通：https://console.volcengine.com/speech/app （控制台 → 豆包语音 → 创建应用）
# 勾选服务：录音文件识别极速版（bigmodel）；资源 ID 与适配器 X-Api-Resource-Id 对应
VOLC_ASR_APP_KEY=            # 控制台应用详情页「APP ID」（旧版控制台亦称 App Key）
VOLC_ASR_ACCESS_KEY=         # 同页「Access Token」

# ── 讯飞开放平台（ASR 对照候选）──
# 开通：https://console.xfyun.cn/services/rtasr （控制台 → 实时语音转写 → 领取/购买服务量）
IFLYTEK_APP_ID=              # 控制台「我的应用」APPID
IFLYTEK_API_KEY=             # 实时语音转写服务的 APIKey

# ── 阿里云百炼（TTS 主线候选 CosyVoice）──
# 开通：https://bailian.console.aliyun.com/ （模型广场开通 cosyvoice-v3.5-flash → API-KEY 管理）
DASHSCOPE_API_KEY=
