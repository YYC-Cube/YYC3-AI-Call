# ============================================
# YYC³ AI Intelligent Calling - 环境变量模板
# 复制此文件为 .env 并填入实际值
# ============================================

# --- 应用配置 ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3077

# --- 数据库 ---
# YYC3 主备环境：NAS 主库 / 本机备库均为 5433；基线 schema 为 yyc3_v2
# 生产/主备推荐通过 scripts/use-yyc3-db.sh 注入 DATABASE_URL（专用角色 yyc3_ai_call_app）
DATABASE_URL=postgresql://yyc3_ai_call_app:CHANGE_ME@localhost:5433/yyc3_ai_call?schema=yyc3_v2
# Docker Compose 数据库密码（必填，生产环境请使用强随机值）
POSTGRES_PASSWORD=change-me-strong-password

# --- Redis ---
REDIS_URL=redis://localhost:6379
# 兼容 NAS 主备环境的 YYC3_ 前缀变量（lib/redis.ts 会自动识别）
# YYC3_REDIS_HOST=localhost
# YYC3_REDIS_PORT=6379
# YYC3_REDIS_PASSWORD=

# --- JWT 认证 ---
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- AI 服务 ---
AI_BASE_URL=http://127.0.0.1:10086/v1
AI_MODEL=chatglm3-6b
AI_TIMEOUT_MS=20000
AI_TEMPERATURE=0.6
AI_MAX_TOKENS=1024

# --- 智谱 AI (可选) ---
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- OpenAI (可选) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- OAuth (可选) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sentry (可选) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- 静态导出模式 (仅 GitHub Pages 使用) ---
# NEXT_STATIC_EXPORT=1
