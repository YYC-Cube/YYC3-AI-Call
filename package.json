  "scripts": {
    "analyze": "ANALYZE=true next build",
    "build": "next build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:status": "prisma migrate status",
    "db:verify": "tsx scripts/verify-db.ts",
    "deploy:dev": "tsx scripts/deploy.ts development",
    "deploy:prod": "tsx scripts/deploy.ts production",
    "deploy:staging": "tsx scripts/deploy.ts staging",
    "dev": "next dev -p 3077",
    "dev:yyc3": "bash -c '. scripts/use-yyc3-db.sh && next dev -p 3077'",
    "db:migrate:yyc3": "bash -c '. scripts/use-yyc3-db-migrate.sh && prisma migrate deploy'",
    "db:status:yyc3": "bash -c '. scripts/use-yyc3-db.sh && prisma migrate status'",
    "db:status:yyc3:migrate": "bash -c '. scripts/use-yyc3-db-migrate.sh && prisma migrate status'",
    "db:verify:yyc3": "bash -c '. scripts/use-yyc3-db.sh && tsx scripts/verify-db.ts'",
    "db:seed:yyc3": "bash -c '. scripts/use-yyc3-db.sh && prisma db seed'",
    "docker:build": "docker build -t yyc-ai-calling:latest .",
    "docker:clean": "docker-compose down -v",
    "docker:logs": "docker-compose logs -f",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "postinstall": "echo '✅ YYC³ AI Intelligent Calling dependencies installed'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "start": "next start",
    "test": "jest tests/unit",
    "test:coverage": "jest tests/unit --coverage",
    "test:e2e": "playwright test",
    "test:integration": "jest tests/integration",
    "test:unit": "jest tests/unit",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
