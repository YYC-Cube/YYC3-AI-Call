// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(USER)
  phone         String?
  avatar        String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联关系
  calls         Call[]
  customers     Customer[]
  sessions      Session[]

  @@map("users")
}

model Customer {
  id            String    @id @default(cuid())
  name          String
  phone         String    @unique
  email         String?
  company       String?
  position      String?
  industry      String?
  source        String?   @default("manual")
  status        CustomerStatus @default(NEW)
  priority      Priority  @default(MEDIUM)
  tags          String[]
  notes         String?   @db.Text
  lastContactAt DateTime?
  nextFollowUpAt DateTime?
  assignedToId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联关系
  calls         Call[]
  assignments   User?    @relation(fields: [assignedToId], references: [id])
  interactions  Interaction[]

  @@index([status])
  @@index([assignedToId])
  @@index([phone])
  @@map("customers")
}

model Call {
  id            String    @id @default(cuid())
  customerId    String
  userId        String
  type          CallType  @default(OUTBOUND)
  status        CallStatus @default(PENDING)
  duration      Int?      // 秒数
  recordingUrl  String?
  /// 录音到期时间（合规引擎：留存期满由清理任务置空 recordingUrl）
  recordingExpiresAt DateTime?
  transcript    String?   @db.Text
  intent        String?
  sentiment     String?
  score         Float?
  notes         String?   @db.Text
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联关系
  customer      Customer @relation(fields: [customerId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
  interactions  Interaction[]

  @@index([customerId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("calls")
}

model Interaction {
  id            String    @id @default(cuid())
  callId        String
  customerId    String?
  type          InteractionType
  content       String    @db.Text
  metadata      Json?
  timestamp     DateTime  @default(now())

  // 关联关系
  call          Call     @relation(fields: [callId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])

  @@index([callId])
  @@index([customerId])
  @@index([timestamp])
  @@map("interactions")
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  token         String    @unique
  refreshToken  String?
  expiresAt     DateTime
  ipAddress     String?
  userAgent     String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联关系
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model AuditLog {
  id            String    @id @default(cuid())
  userId        String?
  action        String
  resourceType  String
  resourceId    String
  details       Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@map("audit_logs")
}

// 枚举类型定义
enum Role {
  USER
  AGENT
  MANAGER
  ADMIN
}

enum CustomerStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CallType {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
  NO_ANSWER
  BUSY
}

enum InteractionType {
  TRANSCRIPT
  INTENT_RECOGNITION
  SENTIMENT_ANALYSIS
  SYSTEM_EVENT
  NOTE
}

// ============================================
// 合规引擎（预呼校验 / 禁拨名单 / 号码状态机）
// ============================================

/// 外呼号码状态机：AVAILABLE 可用 | SUSPENDED 待审（默认，需授权凭证方可转可用）| BLOCKED 禁用
model PhoneNumber {
  id            String            @id @default(cuid())
  number        String            @unique
  status        PhoneNumberStatus @default(SUSPENDED)
  carrier       String?           // 电信 / 移动 / 联通
  /// 运营商授权凭证编号（对接官方号码报备；空则不可转 AVAILABLE）
  authorization String?
  /// 单号码日呼上限（预呼频次闸默认取此值）
  dailyLimit    Int               @default(3)
  tenantId      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  callTasks     OutboundTask[]

  @@index([status])
  @@map("phone_numbers")
}

/// 禁拨名单：COMPLAINT 投诉 | OPT_OUT 退订 | REGULATOR 监管下发；expiresAt 为空表示永久
model DncEntry {
  id        String    @id @default(cuid())
  phone     String    @unique
  reason    DncReason
  source    String?
  expiresAt DateTime?
  tenantId  String?
  createdAt DateTime  @default(now())

  @@index([phone])
  @@map("dnc_entries")
}

/// 外呼任务：预呼校验落点，五道闸快照存 complianceSnap；BLOCKED 即禁止发起
model OutboundTask {
  id             String     @id @default(cuid())
  phoneNumberId  String
  customerId     String?
  callId         String?
  status         TaskStatus @default(DRAFT)
  /// 预呼校验快照（五道闸结果 JSON）
  complianceSnap Json?
  scheduledAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  phoneNumber    PhoneNumber @relation(fields: [phoneNumberId], references: [id])

  @@index([status])
  @@index([phoneNumberId])
  @@map("outbound_tasks")
}

enum PhoneNumberStatus {
  AVAILABLE
  SUSPENDED
  BLOCKED
}

enum DncReason {
  COMPLAINT
  OPT_OUT
  REGULATOR
}

enum TaskStatus {
  DRAFT
  COMPLIANCE_PASSED
  DIALING
  COMPLETED
  FAILED
  BLOCKED
}
